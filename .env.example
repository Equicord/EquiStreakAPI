PORT=3000
BIND=0.0.0.0
REDIS_URL=redis://localhost:6379
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/authorize
MASTER_API_KEY=your_super_secret_master_key_at_least_32_chars
RATE_LIMIT_PER_MIN=60
AUTH_CACHE_TTL_S=300
# THREAD_POOL_SIZE=<nproc>

# Set TRUST_XFF=1 only when deployed behind a reverse proxy that ALWAYS overwrites
# the inbound X-Forwarded-For header. Otherwise leave unset (or 0) so per-IP rate
# limits key on the TCP peer address.
# TRUST_XFF=1
